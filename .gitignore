# ===== Node / Vite =====
node_modules/
dist/
dist-ssr/
.vite/
*.local
# File cache incremental của TypeScript — sinh ra mỗi lần build, không cần lưu
*.tsbuildinfo

# ===== SECRET — TUYỆT ĐỐI KHÔNG COMMIT =====
# Mật khẩu thật, JWT key, connection string production
.env
.env.*
!.env.example
appsettings.Production.json
# File này chứa khoá ký JWT thật. Bản mẫu để người khác clone về dùng là
# appsettings.Development.example.json (đã commit, không có secret thật).
appsettings.Development.json
secrets.json

# ===== Tài liệu Word (báo cáo) =====
# Báo cáo đang được chỉnh sửa liên tục trong Word → commit gây xung đột merge
# và repo phình to. Bản gốc nằm ở thư mục cha, PHẢI tự sao lưu riêng.
*.docx
~$*.docx

# ===== File rác =====
*.log
logs/
tmp/
temp/
Thumbs.db
desktop.ini
.DS_Store

# ===== Công cụ hỗ trợ =====
# Ảnh chụp màn hình sinh ra khi kiểm thử tay — chỉ dùng để trao đổi trong
# cuộc trò chuyện, không phải tài liệu của đồ án nên không commit.
.openchamber/

# ===== Ảnh tạm chưa dùng =====
# 22 ảnh trong các thư mục dưới đây KHÔNG phải ảnh phòng homestay mà là poster
# quảng cáo của một dự án khác ("Nhà Ở Hẻm"). Không commit để tránh đưa tài
# sản của người khác vào repo đồ án. Sẽ bỏ dòng này khi thay bằng ảnh thật.
client/public/images/rooms/cozy/
client/public/images/rooms/japandi/
client/public/images/rooms/signature/

# Thư mục ảnh minh hoạ tải về. Pattern cố tình KHÔNG ghi dấu tiếng Việt
# (dùng `*` thay cho ký tự có dấu) vì Git so khớp theo byte, ghi sai dấu là
# không khớp và ảnh lọt vào commit.
*nh minh h*a/
